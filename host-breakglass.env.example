GPT_HOST_BREAKGLASS_TUNNEL_CLIENT_BIN=C:\Tools\openai-tunnel-client\v0.0.14\tunnel-client.exe

# Create these in OpenAI Platform Tunnels / Runtime API Keys.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=
