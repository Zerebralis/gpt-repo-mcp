# GPT Host Breakglass local transport configuration.
# Copy values into %LOCALAPPDATA%\gpt-repo-host-breakglass\host.env.
GPT_HOST_BREAKGLASS_CONFIG=C:\Tools\gpt-repo-mcp\config.host-breakglass.local.json
GPT_HOST_BREAKGLASS_PORT=8797
GPT_HOST_BREAKGLASS_MAX_SESSIONS=100
GPT_HOST_BREAKGLASS_SESSION_IDLE_TTL_MS=600000
GPT_HOST_BREAKGLASS_SESSION_PRESSURE_IDLE_TTL_MS=60000
GPT_HOST_BREAKGLASS_SESSION_SOFT_TARGET=80
GPT_HOST_BREAKGLASS_TUNNEL_CLIENT_BIN=C:\Tools\openai-tunnel-client\v0.0.14\tunnel-client.exe
GPT_HOST_BREAKGLASS_TUNNEL_POLL_STARTUP_TIMEOUT_MS=90000
GPT_HOST_BREAKGLASS_TUNNEL_POLL_STALE_MS=180000
GPT_HOST_BREAKGLASS_COMPUTER_USE_ENTRY=C:\Tools\computer-use-runtime\node_modules\@zavora-ai\computer-use-mcp\dist\http.js
GPT_HOST_BREAKGLASS_COMPUTER_USE_PROFILE=ax
GPT_HOST_BREAKGLASS_COMPUTER_USE_ACTIVE_PROFILE=ax

# Create these in OpenAI Platform Tunnels / Runtime API Keys.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=
# Optional when your Platform setup requires an explicit organization.
CONTROL_PLANE_ORGANIZATION_ID=
